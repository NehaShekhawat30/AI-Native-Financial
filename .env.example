# ==========================================
# NYC Restaurant Co. - Environment Config
# ==========================================

# Django Secret Key (Generate a random 50-character string for production)
SECRET_KEY=django-insecure-replace-with-a-secure-random-string-in-production

# Set to False in production
DEBUG=False

# Allowed hostnames (comma-separated, or leave empty to default to Render/Railway domains)
# Example: my-finzcard-app.onrender.com,localhost
ALLOWED_HOSTS=*.onrender.com,*.railway.app,localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated, must include scheme)
# Example: https://my-finzcard-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app

# Database Connection (Render / Railway PostgreSQL URL)
# If omitted or empty, Django falls back automatically to local SQLite (db.sqlite3)
DATABASE_URL=postgres://username:password@hostname:5432/database_name

# Google Gemini API Key (Required for Pass 2 LLM categorization and AI Chat Analyst)
GEMINI_API_KEY=your-gemini-api-key-here
